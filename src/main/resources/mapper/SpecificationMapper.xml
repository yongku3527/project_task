<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.quanhai.dingdingdemo.file.mapper.SpecificationMapper">

    <!-- 规格书结果映射 -->
    <resultMap id="SpecificationResultMap" type="com.quanhai.dingdingdemo.file.dto.SpecificationDTO">
        <id property="id" column="id"/>
        <result property="materialId" column="material_id"/>
        <result property="drawingType" column="drawing_type"/>
        <result property="itemName" column="item_name"/>
        <result property="model" column="model"/>
        <result property="fileId" column="file_id"/>
        <result property="fileUrl" column="file_url"/>
        <result property="fileName" column="file_name"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- 根据ID查询规格书及其文件信息 -->
    <select id="selectSpecificationById" parameterType="java.lang.Long" resultMap="SpecificationResultMap">
        SELECT 
            s.id,
            s.material_id,
            s.drawing_type,
            s.item_name,
            s.model,
            s.file_id,
            s.status,
            s.create_time,
            s.update_time,
            f.file_url as file_url,
            f.file_name as file_name
        FROM 
            doc_specification s
        LEFT JOIN 
            file_info f ON s.file_id = f.id
        WHERE 
            s.id = #{id}
    </select>

    <!-- 根据原材料ID查询规格书列表 -->
    <select id="selectSpecificationsByMaterialId" parameterType="java.lang.String" resultMap="SpecificationResultMap">
        SELECT 
            s.id,
            s.material_id,
            s.drawing_type,
            s.item_name,
            s.model,
            s.file_id,
            s.status,
            s.create_time,
            s.update_time,
            f.file_url as file_url,
            f.file_name as file_name
        FROM 
            doc_specification s
        LEFT JOIN 
            file_info f ON s.file_id = f.id
        WHERE 
            s.material_id = #{materialId}
    </select>

    <!-- 查询所有规格书及其文件信息 -->
    <select id="selectAllSpecificationsWithFiles" resultMap="SpecificationResultMap">
        SELECT 
            s.id,
            s.material_id,
            s.drawing_type,
            s.item_name,
            s.model,
            s.file_id,
            s.status,
            s.create_time,
            s.update_time,
            f.file_url as file_url,
            f.file_name as file_name
        FROM 
            doc_specification s
        LEFT JOIN 
            file_info f ON s.file_id = f.id
    </select>
</mapper>